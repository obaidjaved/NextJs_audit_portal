# --- Database ---
# Postgres connection string. In production, use Vercel Postgres (or any managed Postgres).
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js ---
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"
# Needed for `next start` behind a proxy / on your own host (Vercel sets this automatically).
AUTH_TRUST_HOST="true"

# --- Google reCAPTCHA v3 (invisible, score-based) on the public /request-quote form ---
# Create v3 keys at https://www.google.com/recaptcha/admin (add your domains + localhost).
# The site key is public; the secret key must stay server-side. The form refuses
# submissions if the secret is missing.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Optional: minimum score (0.0-1.0) to accept a submission. Default 0.5.
# RECAPTCHA_MIN_SCORE="0.5"

# --- Optional: photo uploads in production (Vercel Blob). Without it, uploads go to public/uploads. ---
# BLOB_READ_WRITE_TOKEN=""

# --- Local dev only: works around `prisma dev`'s local Postgres dropping connections under load. ---
# PG_POOL_MAX_USES="1"
